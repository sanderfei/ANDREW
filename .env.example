# Copy this file to .env, fill only the providers you actually use, then load it
# before directly running a legacy lesson: set -a && source .env && set +a
# Never commit .env or paste a real key into a lesson file.

# OpenAI-compatible provider used by the existing prompt/LangChain lessons.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://ai-hub.digiwincloud.com.cn/v1
ZHIPU_CHAT_MODEL=ep-qwen2.5-72b
ZHIPU_EMBEDDING_MODEL=embedding-3

# Optional overrides for 3_rag_from_scratch local embeddings.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_CACHE=~/.cache/fastembed
LOCAL_EMBEDDING_PATH=~/.cache/fastembed/paraphrase-multilingual-MiniLM-L12-v2-modelscope

# Optional LangSmith tracing for the later observability stage.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=andrew-ai-learning

# 4_rag_knowledge_base_service 默认同样使用本地 MiniLM；live 回答复用上面的
# ZHIPU_*。只有显式选择 glm embedding 才调用远程 embedding-3。
RAG_MODE=offline
RAG_EMBEDDING_MODE=local
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=
