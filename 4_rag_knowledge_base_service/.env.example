# 默认使用本地 MiniLM + 离线摘录回答，无需任何密钥。
# 也会自动读取仓库根目录 .env；不要提交任何 .env。
RAG_MODE=offline
RAG_EMBEDDING_MODE=local
RAG_COLLECTION_NAME=andrew_rag_knowledge_base
RAG_SOURCE_DIR=data/source
RAG_RUNTIME_DIR=runtime
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.10
RAG_MIN_LEXICAL_OVERLAP=0.12
RAG_MAX_CONTEXT_CHARS=6000
RAG_TIMEOUT_SECONDS=30

# 本机 MiniLM，与 3_rag_from_scratch 共用同一模型缓存。
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_CACHE=~/.cache/fastembed
LOCAL_EMBEDDING_PATH=~/.cache/fastembed/paraphrase-multilingual-MiniLM-L12-v2-modelscope

# 仅 RAG_MODE=live 或 RAG_EMBEDDING_MODE=glm 时需要 Key。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://ai-hub.digiwincloud.com.cn/v1
ZHIPU_CHAT_MODEL=ep-qwen2.5-72b
ZHIPU_EMBEDDING_MODEL=embedding-3

# 可选：只覆盖目录 4 使用的模型名；默认复用上面的 ZHIPU_*。
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=

# 可选；离线评测和 CI 不会读取 LangSmith 凭据。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=andrew-rag-knowledge-base
