# 默认无需任何密钥。复制为 .env 后按需修改；不要提交 .env。
RAG_MODE=offline
RAG_COLLECTION_NAME=andrew_rag_knowledge_base
RAG_SOURCE_DIR=data/source
RAG_RUNTIME_DIR=runtime
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_RELEVANCE=0.10
RAG_MIN_LEXICAL_OVERLAP=0.12
RAG_MAX_CONTEXT_CHARS=6000
RAG_TIMEOUT_SECONDS=30

# 仅 RAG_MODE=live 时必填。OPENAI_BASE_URL 可指向 OpenAI-compatible endpoint。
OPENAI_API_KEY=
OPENAI_BASE_URL=
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# 可选；离线评测和 CI 不会读取 LangSmith 凭据。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=andrew-rag-knowledge-base
